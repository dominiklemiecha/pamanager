# Backend Cora (NestJS). Copia in backend/.env per lo sviluppo.
# APP_ENV e' obbligatoria: development | test | staging | production.
# Fuori da production il backend parte solo con database e SMTP locali.
APP_ENV=development
APP_PORT=3100
FRONTEND_URL=http://localhost:5180

# Postgres di sviluppo (docker-compose.node.yml): solo dati sintetici.
DB_HOST=localhost
DB_PORT=5444
DB_USERNAME=cora
DB_PASSWORD=cora_sviluppo
DB_DATABASE=cora
# Isolamento tra aziende nel database (Row Level Security). off per spegnerlo.
DB_RLS=on
# true: applica le migrazioni all'avvio del backend.
RUN_MIGRATIONS=false

# Sessione: token in cookie httpOnly. In production almeno 32 caratteri casuali.
JWT_SECRET=
JWT_REFRESH_SECRET=
# Azienda servita da api/attendance.php al CRM (slug)
CRM_COMPANY_SLUG=connecteed
# Durata dei token delle API esterne in secondi
JWT_EXPIRY=3600
# Chiave per i segreti salvati nel database (token Wrike, TOTP).
APP_ENCRYPTION_KEY=

# Token Wrike salvati dal PHP senza APP_ENCRYPTION_KEY: chiave dalle credenziali
# del vecchio MySQL (password e nome del database). Solo lettura, dopo il passaggio.
LEGACY_DB_PASSWORD=
LEGACY_DB_NAME=

# Indirizzo pubblico dell'app: base di tutti i link nelle email.
APP_URL=http://localhost:5180

# Email (stessi nomi del PHP). In sviluppo Mailpit: http://localhost:8046
SMTP_ENABLED=1
SMTP_HOST=localhost
SMTP_PORT=1046
SMTP_ENCRYPTION=none
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@cora.test
SMTP_FROM_NAME=ConnecteedHR

# Cartelle dei file (documenti, buste paga, allegati, foto).
STORAGE_DIR=./storage
UPLOAD_DIR=./uploads

# Superadmin (/superadmin): utente, hash bcrypt della password (anche in base64)
# e segreto TOTP in Base32. In alternativa: file storage/superadmin.env.
SUPERADMIN_USER=
SUPERADMIN_PASS_HASH=
SUPERADMIN_TOTP_SECRET=

# Vista Cora dell'HR (Figma "Modulo Cora · HR"): 1 = attiva, vuoto = interfaccia classica
HR_CORA_UI=
