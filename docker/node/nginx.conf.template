# Cora (nuovo stack): SPA React + inoltro al backend NestJS degli indirizzi
# rimasti uguali al PHP. Le variabili ${...} arrivano dall'ambiente del container.

# IP reale del client: Traefik (rete interna) lo aggiunge in X-Forwarded-For.
# Al backend arriva un solo indirizzo, quello del client (trust proxy = 1).
set_real_ip_from 10.0.0.0/8;
set_real_ip_from 172.16.0.0/12;
set_real_ip_from 192.168.0.0/16;
set_real_ip_from 127.0.0.1;
real_ip_header X-Forwarded-For;
real_ip_recursive on;

map $http_x_forwarded_proto $proto_client {
    default $http_x_forwarded_proto;
    ''      $scheme;
}

# Pagine staff agli indirizzi del PHP: la navigazione (GET di una pagina HTML)
# resta alla SPA, le chiamate degli script (POST, fetch) vanno al backend.
map "$request_method:$http_accept" $staff_spa {
    default                       0;
    "~^(GET|HEAD):.*text/html"    1;
}

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    server_tokens off;
    charset utf-8;

    client_max_body_size 80m;
    proxy_read_timeout 120s;

    # Header di sicurezza della SPA (come setSecurityHeaders del PHP).
    # Le risposte del backend portano i propri (helmet).
    set $csp "default-src 'self'; script-src 'self' 'unsafe-inline' ${CRM_ORIGIN}; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://rsms.me; img-src 'self' data: blob: https://chart.googleapis.com https://www.connecteed.com; font-src 'self' https://fonts.gstatic.com https://rsms.me; connect-src 'self' ${CRM_ORIGIN}; media-src 'self' blob:; object-src 'none'; frame-src 'self' blob: ${CRM_ORIGIN}; child-src 'self' blob: ${CRM_ORIGIN}; worker-src 'self'; form-action 'self'; frame-ancestors 'none'; base-uri 'self'; manifest-src 'self'${CSP_UPGRADE}";
    set $permessi "accelerometer=(), autoplay=(), camera=(self), display-capture=(), encrypted-media=(), fullscreen=(self), geolocation=(), gyroscope=(), magnetometer=(), microphone=(self), midi=(), payment=(), picture-in-picture=(), publickey-credentials-get=(), screen-wake-lock=(), sync-xhr=(), usb=(), web-share=(), xr-spatial-tracking=()";

    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto $proto_client;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header Connection "";

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml application/manifest+json;

    # --- Backend ---------------------------------------------------------
    # ^~: gli indirizzi /api/*.php non devono finire nella regola dei .php della SPA.
    location ^~ /api/ {
        proxy_pass ${BACKEND_URL};
        # Materiali dell'Academy: fino a 200 MB (MATERIALE_MAX del backend).
        location ~ ^/api/v1/pagine/[a-z-]+/academy {
            client_max_body_size 210m;
            proxy_request_buffering off;
            proxy_read_timeout 600s;
            proxy_pass ${BACKEND_URL};
        }
    }
    location ^~ /uploads/ {
        proxy_pass ${BACKEND_URL};
    }
    location ~ ^/(communication_file|academy-file|punch|verifica-attestato)\.php$ {
        proxy_pass ${BACKEND_URL};
    }
    location = /employee/contract-pdf.php {
        proxy_pass ${BACKEND_URL};
    }
    location ~ ^/(admin|admin-reparto|accountant|consulente-lavoro|formatore)/[a-z0-9_-]+\.php$ {
        if ($staff_spa) {
            rewrite ^ /index.html last;
        }
        proxy_pass ${BACKEND_URL};
    }

    # Chat in tempo reale (Socket.IO).
    location ^~ /realtime/ {
        proxy_pass ${REALTIME_URL};
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_read_timeout 3600s;
    }

    # --- File statici ------------------------------------------------------
    # Icone richieste come icon.php?size=N (manifest del PHP).
    location = /assets/images/icon.php {
        set $lato 192;
        if ($arg_size ~ ^(72|96|128|144|152|192|384|512)$) {
            set $lato $arg_size;
        }
        rewrite ^ /assets/images/icon-$lato.png last;
    }
    location ~ ^/manifest(-cora)?\.json\.php$ {
        types { }
        default_type application/manifest+json;
        add_header Cache-Control "no-cache";
        try_files $uri =404;
    }
    # Service worker e pagina offline: sempre la versione nuova.
    location ~ ^/(sw\.js|offline\.html)$ {
        add_header Cache-Control "no-cache";
        try_files $uri =404;
    }
    # File con l'impronta nel nome (build di Vite): non cambiano mai.
    location ~ "^/assets/.+-[A-Za-z0-9_-]{8}\.(js|css)$" {
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }
    location /assets/ {
        add_header Cache-Control "no-cache";
        try_files $uri =404;
    }
    # Altri .php mai serviti come file: sono pagine della SPA.
    location ~ \.php$ {
        try_files /index.html =404;
        include /etc/nginx/snippets/spa-headers.inc;
    }

    # --- SPA ---------------------------------------------------------------
    location / {
        try_files $uri /index.html;
        include /etc/nginx/snippets/spa-headers.inc;
    }
    location = /index.html {
        include /etc/nginx/snippets/spa-headers.inc;
    }
}
